# Copy to .env.local for local development. These values are public in the app.
APP_ENV=development
# Set when the corresponding services are provisioned; empty is valid for the shell.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Obtain from the Expo project; never invent an ID.
EAS_PROJECT_ID=
# Never put service-role keys, signing secrets, or LLM keys in public config.
